# Experimental bring-up scaffold; NOT flashable or independently bootable.
# FIXME before upstreaming: maintainer and validated kernel package/deps.
pkgname=device-nothing-asteroidspro
pkgdesc="Nothing Phone (3a) Pro (A059P) experimental Nura device metadata"
pkgver=0
pkgrel=0
url="https://nura.eco"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# Intentionally no kernel package: original Linux 7.3 kernel lives in a
# separate UniXNU EFI payload whose packaging remains unresolved.
depends="postmarketos-base"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"
}

