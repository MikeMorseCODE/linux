#!/usr/bin/env python3
"""Validate the exporter-visible secondary bring-up commit in pmsg."""

import argparse
import struct
import sys


SESSION_MAGIC = 0x41535453
CHECKPOINTS = {0: "custom boot, no secondary checkpoint",
               0x5546: "first operation in __secondary_switched",
               0x5547: "VBAR_EL1 installed and ISB completed",
               0x5548: "secondary_data.task loaded",
               0x5549: "stack-pointer and stack frame installed",
               0x554a: "immediately before secondary_start_kernel"}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("record")
    args = parser.parse_args()
    data = open(args.record, "rb").read()

    # The authoritative record is at physical +0x70. Ramoops exports
    # persistent_ram_buffer.data, which begins at physical +0x0c.
    off = 0x70 - 0x0c
    if len(data) < off + 16:
        print(f"UNRECOVERABLE: record is {len(data)} bytes; need {off + 16}")
        return 2

    session, session_complement, stage, stage_complement = \
        struct.unpack_from("<IIII", data, off)
    print(f"record_bytes={len(data)} offset=0x{off:x} "
          f"session=0x{session:08x} session_complement=0x{session_complement:08x} "
          f"stage=0x{stage:08x} stage_complement=0x{stage_complement:08x}")
    if (session != SESSION_MAGIC or
            session_complement != ((~session) & 0xffffffff) or
            stage_complement != ((~stage) & 0xffffffff) or
            stage not in CHECKPOINTS):
        print("UNRECOVERABLE: invalid session or stage commit")
        return 2

    print(f"VALID: {CHECKPOINTS[stage]} (0x{stage:04x})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
